<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Retailoperations.views.TaskDetailsPage"
    Title="Task Details">

    <ScrollView>

        <VerticalStackLayout
            Padding="25"
            Spacing="18">

            <Label
                Text="{Binding Title}"
                FontSize="28"
                FontAttributes="Bold" />

            <Label
                Text="Task Description"
                FontSize="18"
                FontAttributes="Bold" />

            <Border
                Padding="15">

                <Label
                    Text="{Binding Description}"
                    FontSize="16"
                    LineBreakMode="WordWrap" />

            </Border>


            <!-- Task Information -->

            <Grid
                ColumnDefinitions="Auto,*"
                RowDefinitions="Auto,Auto"
                RowSpacing="15"
                ColumnSpacing="20">

                <Label
                    Grid.Row="0"
                    Grid.Column="0"
                    Text="Priority:"
                    FontAttributes="Bold" />

                <Label
                    Grid.Row="0"
                    Grid.Column="1"
                    Text="{Binding Priority}" />

                <Label
                    Grid.Row="1"
                    Grid.Column="0"
                    Text="Due Date:"
                    FontAttributes="Bold" />

                <Label
                    Grid.Row="1"
                    Grid.Column="1"
                    Text="{Binding DueDate, StringFormat='{0:dd MMM yyyy HH:mm}'}" />

            </Grid>


            <!-- Update Progress -->

            <Label
                Text="Update Task Progress"
                FontSize="18"
                FontAttributes="Bold" />

            <Picker
    Title="Select Status"
    SelectedItem="{Binding Status, Mode=TwoWay}">

                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Pending</x:String>
                        <x:String>In Progress</x:String>
                        <x:String>Completed</x:String>
                    </x:Array>
                </Picker.ItemsSource>

            </Picker>


            <!-- Current Status -->

            <Label
                Text="{Binding Status, StringFormat='Current Status: {0}'}"
                FontSize="16"
                FontAttributes="Bold" />


            <!-- Back -->

            <Button
                Text="Back to Tasks"
                HeightRequest="50"
                CornerRadius="10"
                Clicked="BackButton_Clicked" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>