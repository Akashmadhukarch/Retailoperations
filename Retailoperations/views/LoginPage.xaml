<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Retailoperations.views.LoginPage"
    Title="Login">

    <VerticalStackLayout
        Padding="30"
        Spacing="20"
        VerticalOptions="Center">

        <Label
            Text="Retail Operations"
            FontSize="28"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <Label
            Text="Employee Management"
            FontSize="16"
            HorizontalOptions="Center" />

        <Label
            Text="Select your role to login:"
            FontSize="16"
            Margin="0,20,0,0" />

        <Button
            Text="Manager Login"
            HeightRequest="50"
            CornerRadius="10"
            Clicked="ManagerLogin_Clicked" />

        <Button
            Text="Employee Login"
            HeightRequest="50"
            CornerRadius="10"
            Clicked="EmployeeLogin_Clicked" />

    </VerticalStackLayout>

</ContentPage>