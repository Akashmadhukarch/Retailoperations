<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Retailoperations.views.ManagerLoginPage"
    Title="Manager Login">
    <VerticalStackLayout
        Padding="30"
        Spacing="20"
        VerticalOptions="Center">
        <Label
            Text="Manager Login"
            FontSize="28"
            FontAttributes="Bold"
            HorizontalOptions="Center" />
        <Entry
            Placeholder="Email"
            Keyboard="Email"
            Text="{Binding Email}" />
        <Entry
            Placeholder="Password"
            IsPassword="True"
            Text="{Binding Password}" />
        <Button
            Text="Login"
            Command="{Binding LoginCommand}"
            HeightRequest="50"
            CornerRadius="10" />
        <Button
            Text="Back"
            HeightRequest="50"
            CornerRadius="10"
            Clicked="Back_Clicked" />
    </VerticalStackLayout>
</ContentPage>
