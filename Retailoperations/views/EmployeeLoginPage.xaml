<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Retailoperations.views.EmployeeLoginPage"
    Title="Employee Login">
    <VerticalStackLayout
        Padding="30"
        Spacing="20"
        VerticalOptions="Center">
        <Label
            Text="Employee Login"
            FontSize="28"
            FontAttributes="Bold"
            HorizontalOptions="Center" />
        <Label
            Text="Enter your work email"
            FontSize="14"
            HorizontalOptions="Center" />
        <Entry
            Placeholder="Email (e.g., rahul@store.com)"
            Keyboard="Email"
            Text="{Binding Email}" />
        <Button
            Text="Login"
            Command="{Binding LoginCommand}"
            HeightRequest="50"
            CornerRadius="10" />
        <Button
            Text="Back"
            HeightRequest="50"
            CornerRadius="10"
            Clicked="Back_Clicked" />
    </VerticalStackLayout>
</ContentPage>
