<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Retailoperations.views.DashboardPage"
    Title="Dashboard">

    <ScrollView>

        <VerticalStackLayout
            Padding="25"
            Spacing="20">

            <!-- Header -->

            <VerticalStackLayout Spacing="5">

                <Label
                    Text="Retail Operations"
                    FontSize="28"
                    FontAttributes="Bold" />

                <Label
                    Text="Dashboard"
                    FontSize="20" />

            </VerticalStackLayout>


            <!-- Statistics -->

            <FlexLayout
                Direction="Row"
                Wrap="Wrap"
                JustifyContent="SpaceBetween"
                AlignItems="Start">

                <!-- Pending Tasks -->

                <Border
                    WidthRequest="300"
                    Padding="20"
                    Margin="0,0,10,10">

                    <VerticalStackLayout Spacing="5">

                        <Label
                            Text="Pending Tasks"
                            FontSize="14" />

                        <Label
                            Text="{Binding PendingTasks}"
                            FontSize="28"
                            FontAttributes="Bold" />

                    </VerticalStackLayout>

                </Border>


                <!-- Completed -->

                <Border
                    WidthRequest="300"
                    Padding="20"
                    Margin="0,0,10,10">

                    <VerticalStackLayout Spacing="5">

                        <Label
                            Text="Completed"
                            FontSize="14" />

                        <Label
                            Text="{Binding CompletedTasks}"
                            FontSize="28"
                            FontAttributes="Bold" />

                    </VerticalStackLayout>

                </Border>


                <!-- Employees -->

                <Border
                    WidthRequest="300"
                    Padding="20"
                    Margin="0,0,10,10">

                    <VerticalStackLayout Spacing="5">

                        <Label
                            Text="Employees"
                            FontSize="14" />

                        <Label
                            Text="{Binding Employees}"
                            FontSize="28"
                            FontAttributes="Bold" />

                    </VerticalStackLayout>

                </Border>


                <!-- Open Issues -->

                <Border
                    WidthRequest="300"
                    Padding="20"
                    Margin="0,0,10,10">

                    <VerticalStackLayout Spacing="5">

                        <Label
                            Text="Open Issues"
                            FontSize="14" />

                        <Label
                            Text="{Binding OpenIssues}"
                            FontSize="28"
                            FontAttributes="Bold" />

                    </VerticalStackLayout>

                </Border>

            </FlexLayout>


            <!-- Recent Tasks -->

            <Label
                Text="Recent Tasks"
                FontSize="20"
                FontAttributes="Bold"
                Margin="0,10,0,0" />

            <CollectionView
                ItemsSource="{Binding RecentTasks}"
                SelectionMode="None">

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Border
                            Padding="15"
                            Margin="0,0,0,10">

                            <VerticalStackLayout
                                Spacing="6">

                                <Label
                                    Text="{Binding Title}"
                                    FontSize="17"
                                    FontAttributes="Bold" />

                                <Label
                                    Text="{Binding Priority, StringFormat='Priority: {0}'}"
                                    FontSize="13" />

                                <!-- Automatically updates when Status changes -->

                                <Label
                                    Text="{Binding Status, StringFormat='Status: {0}'}"
                                    FontSize="13" />

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>


            <!-- View All Tasks -->

            <Button
                Text="View All Tasks"
                HeightRequest="50"
                CornerRadius="10"
                Command="{Binding ViewTasksCommand}" />
            <Button
    Text="View Employees"
    HeightRequest="50"
    CornerRadius="10"
    Command="{Binding ViewEmployeesCommand}" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>